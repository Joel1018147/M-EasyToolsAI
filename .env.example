# ─────────────────────────────────────────────
#  M-EasyTools AI+ — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Google OAuth 2.0 credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# The full URL where your app is hosted (no trailing slash)
# Local:      http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000

# Session secret — MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string_at_least_32_chars

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/measytools

# Port the server listens on
PORT=3000

# Groq AI API key (free at console.groq.com)
GROQ_API_KEY=

# Primary inference model (Groq). Qwen 3.6 27B — chosen for strong EN/BM/ZH
# multilingual support across the ecosystem.
# NOTE: Groq currently serves this as a preview-tier model. If it is ever
# rate-limited, degraded, or pulled, set the value below to the fallback and
# redeploy on Railway — no code change required.
GROQ_MODEL=qwen/qwen3.6-27b
# Fallback if qwen/qwen3.6-27b becomes unavailable: openai/gpt-oss-120b

# Set to "production" when deploying live
NODE_ENV=development

# Seller panel secret key
SELLER_KEY=

# iPay88 payment gateway
# Get credentials from: https://merchant.ipay88.com.my
IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=
IPAY88_SANDBOX=true

# Resend transactional email (resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# Image generation — Alibaba Cloud Model Studio (Qwen-Image)
# ─────────────────────────────────────────────────────────────────────────────
# ADDED IN ROUND 1. This variable was ALREADY SET in production and documented
# nowhere, which is how an env var becomes invisible to the next person who
# reads the repo — Gate 0's pre-deploy diff is what found it.
#
# Get a key from https://modelstudio.console.alibabacloud.com (Singapore).
#
# REGION IS NOT INTERCHANGEABLE. Singapore and Beijing have separate keys AND
# separate endpoints; a Singapore key against the Beijing host returns
# 401 InvalidApiKey (verified 2026-08-21). Malaysia-facing deployments use
# Singapore.
DASHSCOPE_API_KEY=

# Base URL. Defaults in code to the international host, which is what a key
# without a workspace id is provisioned for.
#
# Alibaba's current docs document ONLY the newer workspace-scoped form
# (https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com) and do not mention
# the host below at all — but the host below is what actually answers for this
# account, verified end to end. Override here if the account is migrated to a
# workspace-scoped endpoint, so that migration is a variable change and not a
# code push.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# Model. Measured 2026-08-21, one 1328*1328 image each:
#   qwen-image-2.0    2.5s   1.91MB
#   qwen-image        3.5s   1.89MB
#   qwen-image-plus   3.6s   1.87MB   <- default
#   qwen-image-max   16.4s   2.25MB
QWEN_IMAGE_MODEL=qwen-image-plus

# NOTE ON SIZE, because it is the detail that breaks the integration silently:
# the format is width*height with an ASTERISK, not an "x" — and 1024*1024 is
# NOT a legal value for this model family. The API returns
#   InvalidParameter: The size does not match the allowed size
#   1664*928,1472*1104,1328*1328,1104*1472,928*1664
# The legal set is in lib/image/, not here, so there is one source of truth.
